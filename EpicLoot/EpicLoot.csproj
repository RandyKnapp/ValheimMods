<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Paths.props" />
  <Import Project="..\BuildTasks.props" />

  <ItemGroup>
    <!-- This is the only project pulling the JotunnLib package, and JotunnLib's props resolve the
         vanilla assemblies from <Valheim>/valheim_Data/Managed/publicized_assemblies - a folder
         nothing in this repo generates, so the build silently depended on someone having
         publicized by hand. Drop those and take the stock assemblies instead;
         BepInEx.AssemblyPublicizer.MSBuild publicizes them into obj/ (see
         ..\Directory.Build.targets), so a game update is picked up on the next build.

         assembly_valheim, assembly_utils and assembly_guiutils are not re-added here: Paths.props
         already carries them, and Directory.Build.targets marks those Publicize="true". -->
    <Reference Remove="assembly_valheim_publicized" />
    <Reference Remove="assembly_utils_publicized" />
    <Reference Remove="assembly_guiutils_publicized" />
    <Reference Remove="assembly_googleanalytics_publicized" />
    <Reference Remove="assembly_lux_publicized" />
    <Reference Remove="assembly_postprocessing_publicized" />
    <Reference Remove="assembly_simplemeshcombine_publicized" />
    <Reference Remove="assembly_sunshafts_publicized" />
    <Reference Remove="SoftReferenceableAssets_publicized" />
    <Reference Remove="gui_framework_publicized" />

    <Reference Include="assembly_googleanalytics" Publicize="true">
      <HintPath>$(GamePathManaged)assembly_googleanalytics.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="assembly_lux" Publicize="true">
      <HintPath>$(GamePathManaged)assembly_lux.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="assembly_postprocessing" Publicize="true">
      <HintPath>$(GamePathManaged)assembly_postprocessing.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="assembly_simplemeshcombine" Publicize="true">
      <HintPath>$(GamePathManaged)assembly_simplemeshcombine.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="assembly_sunshafts" Publicize="true">
      <HintPath>$(GamePathManaged)assembly_sunshafts.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="SoftReferenceableAssets" Publicize="true">
      <HintPath>$(GamePathManaged)SoftReferenceableAssets.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="gui_framework" Publicize="true">
      <HintPath>$(GamePathManaged)gui_framework.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>EpicLoot</RootNamespace>
    <AssemblyName>EpicLoot</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>12</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="config-patches\**" />
    <EmbeddedResource Remove="config-patches\**" />
    <None Remove="config-patches\**" />
    <None Remove="localizations\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\ValheimUnity\AssetBundles\epicloot">
      <Link>epicloot</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="config\*.json" />
    <EmbeddedResource Include="config\*\*\*.json" />
    <EmbeddedResource Include="localizations\*.json" />
    <None Include="info.md" />
    <None Include="packages.config" />
    <None Include="Package\manifest.json" />
    <None Include="Package\CHANGELOG.md" />
    <None Include="todo.md" />
    <None Include="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Stage the merged EpicLoot.dll into the Unity project so the enchanting-UI prefabs bind to it
       (replaces the old EpicLoot-UnityLib.dll authoring plugin). Guarded so a bare `dotnet build`
       without SolutionDir skips it instead of failing. Run `-t:CopyAssembliesToUnity` (from
       BuildTasks.props) to refresh the BepInEx/Jotunn/Valheim dependency DLLs alongside it when
       they change. -->
  <Target Name="CopyToUnityForAuthoring" AfterTargets="Build" Condition="Exists('$(SolutionUnity)')">
    <Message Text="Staging EpicLoot.dll into Unity ExternalLibraries for prefab authoring" Importance="high" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(SolutionUnity)Assets\ExternalLibraries" />
  </Target>

  <Import Project="..\Common\Common.projitems" Label="Shared" />

  <!-- BEGIN mod-tools (managed block; replaced by `mod-tools setup`) -->
  <PropertyGroup>
    <RepoRoot Condition=" '$(RepoRoot)' == '' ">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/'))</RepoRoot>
    <!-- Override in the gitignored Environment.props when the gem's bindir
         is not on the PATH that MSBuild sees. -->
    <ModTools Condition=" '$(ModTools)' == '' ">mod-tools</ModTools>
  </PropertyGroup>

  <!-- Nothing is vendored into this repo, so a machine that never installed
       the tools has no mod-tools at all. This probes for it once and warns,
       rather than failing: not having a release tool should not stop anyone
       compiling. Everything below is then conditioned on the result, so a
       machine without it skips those steps instead of failing three times
       over with "command not found" buried in Exec output. -->
  <Target Name="ModToolsGuard" BeforeTargets="Build">
    <Exec Command="$(ModTools) preflight --root &quot;$(RepoRoot).&quot;" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ModToolsExit" />
    </Exec>
    <PropertyGroup>
      <ModToolsAvailable Condition=" '$(ModToolsExit)' == '0' ">true</ModToolsAvailable>
    </PropertyGroup>
    <Warning Condition=" '$(ModToolsAvailable)' != 'true' " Text="mod-tools is not installed on this machine, or this repo is not set up. Skipping release checks, packaging and deploy. Install it with `rake install` from a clone of the tools repo; see its SETUP.md." />
  </Target>

  <Target Name="ReleaseChecks" BeforeTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' AND '$(Configuration)' == 'Release' ">
    <Exec Command="$(ModTools) check --root &quot;$(RepoRoot).&quot;" />
  </Target>

  <Target Name="ReleasePackage" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' AND '$(Configuration)' == 'Release' ">
    <Exec Command="$(ModTools) package --root &quot;$(RepoRoot).&quot;" />
  </Target>

  <!-- No Configuration condition, unlike the two above: every build lands
       in the test profiles, Debug and Release alike. Declared last so it
       runs after a GenerateMdb target defined earlier in this file, whose
       .mdb it copies. Does nothing unless release.yml enables deploy. -->
  <Target Name="ModToolsDeploy" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' ">
    <Exec Command="$(ModTools) deploy --root &quot;$(RepoRoot).&quot; --configuration $(Configuration)" />
  </Target>
  <!-- END mod-tools -->
</Project>