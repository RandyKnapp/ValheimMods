<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>09bcfe16-0d69-481c-98c6-1090d78e3127</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Common</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Recursive by design: every .cs under src/ is compiled into each consuming mod. Do NOT add explicit
         <Compile Include> entries alongside this - Visual Studio adds them automatically when you add a file
         through Solution Explorer, and they collide with the glob ("Duplicate 'Compile' items were included").
         If that happens, delete the explicit entries and keep this line. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\**\*.cs" />
  </ItemGroup>
</Project>